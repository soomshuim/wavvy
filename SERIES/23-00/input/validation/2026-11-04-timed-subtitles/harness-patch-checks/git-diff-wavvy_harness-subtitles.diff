+def _unsung_lines(item: dict, lines: list[str], evidence: dict, extras: dict, track: int) -> frozenset:
+    """Approved source lines that the audio does not sing (direction lines, skipped repeats).
+
+    Each needs its exact approved text, a reason, and hashed audio evidence; it never appears
+    in the SRT and cannot also be an approved sung repeat.
+    """
+    declared = item.get("unsung_source_lines", [])
+    if not isinstance(declared, list):
+        raise SubtitleError(f"Track {track}: malformed unsung_source_lines")
+    found = set()
+    for record in declared:
+        try:
+            line, text, reason, refs = record["source_line"], record["text"], record["reason"], record["evidence"]
+            if type(line) is not int or not 1 <= line <= len(lines) or text != lines[line - 1] or line in found:
+                raise ValueError
+            if not isinstance(reason, str) or not reason.strip() or line in extras:
+                raise ValueError
+            if not isinstance(refs, list) or not refs or any(ref not in evidence for ref in refs):
+                raise ValueError
+        except (KeyError, TypeError, ValueError) as exc:
+            raise SubtitleError(f"Track {track}: invalid unsung source line declaration") from exc
+        found.add(line)
+    if len(found) >= len(lines):
+        raise SubtitleError(f"Track {track}: every source line declared unsung")
+    return frozenset(found)
+
