# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
.pycache/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Wavvy work/output directories (generated files)
**/work/
**/output/*
!**/output/draft_description.txt

# Large media files (optional - uncomment if needed)
# *.mp4
# *.mp3
# *.wav

# Generated video files (regenerable via vfade/pack)
**/input/loop_xfade.mp4
**/input/loop_xfade_test.mp4

# Local media source assets
SERIES/*/input/tracks/*
!SERIES/*/input/tracks/*.txt
SERIES/*/input/loop.png
SERIES/17-30/input/artwork/*.png
SERIES/17-30/input/artwork/*.psd
SERIES/*/input/thumb.psd

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log

